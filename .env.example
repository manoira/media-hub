# Server (Vercel / Render — do not set PORT on hosted platforms)
NODE_ENV=production
BASE_PATH=/

# TMDB API key (v3) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Neon Postgres — use the *pooled* connection string on Vercel (host contains -pooler)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
