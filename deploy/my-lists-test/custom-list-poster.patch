 // Builds standard Stremio/Nuvio metadata for any movie or series keyed by IMDb id.
 // Provides full metadata (details, ratings, cast, genres, seasons, and episodes)
 // so clients without a dedicated metadata addon (like Nuvio) render rich pages automatically.
+async function metaFromInstalledLists(resolved, imdbId, metaType, env) {
+  const entries = Array.isArray(resolved && resolved.entries) ? resolved.entries : [];
+  const keys = { env, verifiedOwner: resolved && resolved.trackOwner || "", trackCreatorName: resolved && resolved.trackCreatorName || "" };
+  for (const entry of entries) {
+    if (!entry || entry.enabled === false || entry.type !== metaType) continue;
+    const payload = parseCustomListPayload(entry.url);
+    if (!payload) continue;
+    let items = Array.isArray(payload.items) ? payload.items : [];
+    const live = await resolveLiveCustomList(env, payload, keys);
+    if (live && Array.isArray(live.items)) items = live.items;
+    const found = items.find((item) => item && (item.imdbId || item.id) === imdbId);
+    if (!found) continue;
+    const posterId = found.imdbId || found.id || imdbId;
+    return {
+      id: imdbId,
+      type: metaType,
+      name: found.title || found.name || imdbId,
+      poster: found.poster || (String(posterId).startsWith("tt") ? "https://images.metahub.space/poster/medium/" + posterId + "/img.jpg" : undefined),
+      releaseInfo: found.year ? String(found.year).slice(0, 4) : undefined,
+    };
+  }
+  return null;
+}
