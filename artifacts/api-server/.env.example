PORT=5000
NODE_ENV=development

# TMDB API key (v3) — required for search/browse/trending/details.
# Get one for free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# TMDB response locale for titles, overviews, and genre names (default: sv-SE).
# TMDB_LANGUAGE=sv-SE

# Postgres connection string — required for watchlist/stats/episode-progress.
# Browse/search/trending work without a real DB.
DATABASE_URL=postgresql://user:password@host:5432/dbname
