PORT=5000
NODE_ENV=development

# TMDB API key (v3) — required for search/browse/trending/details.
# Get one for free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# TMDB response locale for titles, overviews, and genre names (default: sv-SE).
# TMDB_LANGUAGE=sv-SE

# Postgres connection string — required for watchlist/stats/episode-progress.
# Browse/search/trending work without a real DB.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Owner password for the catalog session. Never commit a real value.
OWNER_PASSWORD=

# My Lists creator key. The server only reads this variable.
# A non-empty value means configured, not that My Lists accepted it.
# This app does not save, rotate, or revoke the key.
MY_LISTS_CREATOR_KEY=

# SIMKL access token. Same rule as the creator key: configured is not verified.
SIMKL_TOKEN=

# Browser origins allowed to call the API with cookies.
# ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
