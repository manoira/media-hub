{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "media-hub-worker-harness",
  "main": "src/cloudflare-harness.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "alias": {
    "pino-http": "./src/lib/pino-http-stub.ts"
  },
  "preview_urls": false,
  "assets": {
    "directory": "../../deploy/cloudflare/fixtures",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__worker/*"]
  },
  "vars": {
    "NODE_ENV": "development",
    "BASE_PATH": "/",
    "DATABASE_URL": "postgres://fixture:fixture@127.0.0.1:9/media-hub-fixture"
  }
}
